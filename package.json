{
  "name": "absolutely-fit-club-house",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev": "npm --prefix site run build && node scripts/prepare-site.mjs && next dev",
    "build": "npm --prefix site run build && node scripts/prepare-site.mjs && next build",
    "postbuild": "node scripts/prepare-standalone.mjs && node scripts/content-safety-guard.mjs .next/standalone/site/dist",
    "start": "node scripts/start-standalone.mjs",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "test": "node scripts/content-safety-guard.mjs && node --test tests/*.test.mjs && node tests/reference/test-practical.cjs site/dist/assets/practical.js",
    "content:guard": "node scripts/content-safety-guard.mjs",
    "qa:browser": "node scripts/qa-browser.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "postinstall": "npm ci --prefix site --include=dev",
    "audit": "npm audit --omit=dev --audit-level=high && npm audit --prefix site --omit=dev --audit-level=high",
    "qa:http": "node scripts/qa-http.mjs",
    "pretest": "npm --prefix site run build"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@types/node": "22.19.19",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.8",
    "playwright": "1.62.1",
    "pngjs": "7.0.0"
  },
  "type": "module"
}
